# Local Development Configuration
# Copy this file to .env.local and configure as needed

# Set to 'true' to use local backend instead of EC2
VITE_USE_LOCAL_BACKEND=true

# Port for local backend (default: 8080)
VITE_LOCAL_BACKEND_PORT=8080

# EC2 backend URL (used when VITE_USE_LOCAL_BACKEND is false)
VITE_EC2_BACKEND_URL=ws://52.15.179.179:8080
